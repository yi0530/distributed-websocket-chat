# =========================
# WebSocket Server
# =========================
HOST=0.0.0.0
PORT=8765
NODE_ID=node_a

# =========================
# Redis
# =========================
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_KEY_PREFIX=chat

# =========================
# JWT
# =========================
JWT_SECRET=please_change_me
JWT_ALGORITHM=HS256
JWT_EXP_HOURS=1
TOKEN_REFRESH_WINDOW_SECONDS=600

# =========================
# Heartbeat
# =========================
HEARTBEAT_INTERVAL=5
HEARTBEAT_TIMEOUT=5

# =========================
# Online Presence
# =========================
ONLINE_STATUS_TTL_SECONDS=15
ONLINE_STATUS_RENEW_INTERVAL_SECONDS=5

# =========================
# Offline Message
# =========================
REDIS_OFFLINE_TTL_SECONDS=604800

# =========================
# Dedupe
# =========================
DEDUPE_TTL_SECONDS=600

# =========================
# Development / Test
# =========================
ENABLE_TEST_SEED=false